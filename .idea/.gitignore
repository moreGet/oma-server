# ============================================================
# IDE — GoLand / IntelliJ
# ============================================================
# .idea/.gitignore 가 내부 제외 규칙을 관리하므로 디렉토리 자체는 커밋
# 단, 개인 워크스페이스·히스토리 파일만 추가 제외
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml

